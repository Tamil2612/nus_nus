rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public profile directory. Push tokens live in users/{uid}/private/push.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;

      match /private/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /groups/{groupId} {
      function signedIn() {
        return request.auth != null;
      }

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberUids;
      }

      function isGroupOwner() {
        return signedIn() && request.auth.uid == resource.data.ownerId;
      }

      allow read: if isMember();

      // The creator must remain a member so they cannot lock themselves out.
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.ownerId &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.memberUids is list;

      // Only the owner can change group metadata or membership. Ownership is immutable.
      allow update: if isGroupOwner() &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.memberUids is list;

      allow delete: if isGroupOwner();

      // Group chat is readable only by current group members. Chat content
      // is separate from expense records and cannot alter balances.
      match /messages/{messageId} {
        function chatGroupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function chatGroupMember() {
          return request.auth != null &&
            request.auth.uid in chatGroupData().memberUids;
        }

        allow read: if chatGroupMember();
        allow create: if chatGroupMember() &&
          request.resource.data.keys().hasOnly([
            'senderUid', 'senderName', 'text', 'createdAt'
          ]) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.senderName is string &&
          request.resource.data.senderName.size() > 0 &&
          request.resource.data.senderName.size() <= 80 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /expenses/{expenseId} {
        function groupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function isGroupMember() {
          return request.auth != null &&
            request.auth.uid in groupData().memberUids;
        }

        function isOwner() {
          return request.auth != null &&
            request.auth.uid == groupData().ownerId;
        }

        function validExpense() {
          return request.resource.data.amount is number &&
            request.resource.data.amount > 0 &&
            request.resource.data.amount <= 100000000 &&
            request.resource.data.desc is string &&
            request.resource.data.desc.size() > 0 &&
            request.resource.data.desc.size() <= 200 &&
            request.resource.data.payerId is int &&
            request.resource.data.splitMap is map &&
            request.resource.data.splitMap.keys().size() > 0 &&
            request.resource.data.settledBy is list &&
            request.resource.data.settledAmounts is map &&
            request.resource.data.isSettlement == false &&
            request.resource.data.addedBy == request.auth.uid;
        }

        // Any group member may read expenses and add their own logged expense.
        allow read: if isGroupMember();
        allow create: if isGroupMember() && validExpense();

        // Existing expense identity and authorship cannot be reassigned.
        // Only the original expense logger can edit expense details. Group
        // ownership does not grant edit permission on another member's expense.
        allow update: if isGroupMember() && (
          (
            request.auth.uid == resource.data.addedBy &&
            request.resource.data.addedBy == resource.data.addedBy &&
            request.resource.data.payerId == resource.data.payerId &&
            request.resource.data.isSettlement == resource.data.isSettlement &&
            request.resource.data.createdAt == resource.data.createdAt &&
            (request.auth.uid == resource.data.addedBy ||
              request.resource.data.settledBy == resource.data.settledBy) &&
            (request.resource.data.get('settledAmounts', {}) == resource.data.get('settledAmounts', {}) ||
              (request.auth.uid == resource.data.addedBy &&
                request.resource.data.diff(resource.data).affectedKeys().hasAny(['splitMap', 'amount']))) &&
            request.resource.data.amount is number &&
            request.resource.data.amount > 0 &&
            request.resource.data.amount <= 100000000 &&
            request.resource.data.desc is string &&
            request.resource.data.desc.size() > 0 &&
            request.resource.data.desc.size() <= 200 &&
            request.resource.data.splitMap is map &&
            request.resource.data.splitMap.keys().size() > 0 &&
            request.resource.data.settledBy is list
          ) ||
          // Only the original expense logger can toggle whole-share status.
          // Pairwise partial settlements are written by the trusted callable.
          (
            isGroupMember() &&
            request.auth.uid == resource.data.addedBy &&
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['settledBy']) &&
            request.resource.data.settledBy is list
          )
        );

        // Only the original expense logger may delete an expense.
        allow delete: if isGroupMember() &&
          request.auth.uid == resource.data.addedBy;
      }
    }
  }
}