rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile directory. Push tokens live in users/{uid}/private/push.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;

      match /private/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /groups/{groupId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.memberUids;

      // The creator must be in memberUids so they never lock themselves out.
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.ownerId &&
        request.auth.uid in request.resource.data.memberUids;

      // Only the owner edits the group, and ownership can't be reassigned.
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.ownerId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.auth.uid in request.resource.data.memberUids;

      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;

      match /expenses/{expenseId} {
        function groupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }
        function isMember() {
          return request.auth != null && request.auth.uid in groupData().memberUids;
        }
        function validExpense() {
          return request.resource.data.amount is number &&
            request.resource.data.amount > 0 &&
            request.resource.data.desc is string &&
            request.resource.data.splitMap is map &&
            request.resource.data.settledBy is list &&
            request.resource.data.addedBy == request.auth.uid;
        }

        allow read: if isMember();

        allow create: if isMember() && validExpense();

        // The person who added it can edit it fully (addedBy can't change).
        // Any member can ONLY change settledBy (settling up between people).
        allow update: if isMember() && (
          (request.auth.uid == resource.data.addedBy &&
            request.resource.data.addedBy == resource.data.addedBy &&
            request.resource.data.amount is number &&
            request.resource.data.amount > 0 &&
            request.resource.data.splitMap is map) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settledBy'])
        );

        // Author or group owner can delete.
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.addedBy ||
          request.auth.uid == groupData().ownerId
        );
      }
    }
  }
}