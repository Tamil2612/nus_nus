rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profile documents may contain email and phone metadata. They are private:
    // clients may only read their own profile. Contact matching goes through a
    // trusted, rate-limited backend using the indexed canonical phone key.
    // Push tokens live in users/{uid}/private/push.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isOwner();
      allow create: if isOwner() &&
        !request.resource.data.keys().hasAny(['accountDeletionInProgress']);
      allow update: if isOwner() &&
        resource.data.get('accountDeletionInProgress', false) != true &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['accountDeletionInProgress']);
      allow delete: if isOwner() &&
        resource.data.get('accountDeletionInProgress', false) != true;

      match /private/{document=**} {
        allow read: if isOwner();
        allow write: if isOwner() &&
          get(/databases/$(database)/documents/users/$(uid)).data
            .get('accountDeletionInProgress', false) != true;
      }
    }

    match /groups/{groupId} {
      function accountCanWrite() {
        return request.auth != null &&
          (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data
              .get('accountDeletionInProgress', false) != true);
      }

      function signedIn() {
        return request.auth != null;
      }

      function isMember() {
        return signedIn() &&
          request.auth.uid in resource.data.get('memberUids', []);
      }

      function isGroupOwner() {
        return signedIn() && request.auth.uid == resource.data.ownerId;
      }

      function isOwnPersonalGroupPath() {
        return signedIn() && groupId == 'personal_' + request.auth.uid;
      }

      function canAccessOwnPersonalGroup() {
        return isOwnPersonalGroupPath() &&
          (!exists(/databases/$(database)/documents/groups/$(groupId)) ||
            resource.data.get('ownerId', null) == null ||
            resource.data.get('ownerId', null) == request.auth.uid);
      }

      function canRepairOwnPersonalGroup() {
        return isOwnPersonalGroupPath() &&
          (resource.data.get('ownerId', null) == null ||
            resource.data.get('ownerId', null) == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ownerId', 'isPersonal', 'memberUids', 'members']) &&
          request.resource.data.ownerId == request.auth.uid &&
          request.resource.data.isPersonal == true &&
          request.resource.data.memberUids is list &&
          request.auth.uid in request.resource.data.memberUids &&
          request.resource.data.memberUids
            .hasAll(resource.data.get('memberUids', [])) &&
          request.resource.data.members is list &&
          request.resource.data.members
            .hasAll(resource.data.get('members', []));
      }

      // Allow the owner to recover their deterministic personal group if
      // older documents are missing memberUids. Shared groups remain member-only.
      allow read: if isMember() || isGroupOwner() || canAccessOwnPersonalGroup();

      // The creator must remain a member so they cannot lock themselves out.
      // Group ids that look like personal ledgers may only be created by the
      // account they belong to, so nobody can squat another user's id.
      allow create: if accountCanWrite() && signedIn() &&
        (!groupId.matches('personal_.*') || groupId == 'personal_' + request.auth.uid) &&
        request.auth.uid == request.resource.data.ownerId &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.memberUids is list;

      // Owners can manage group metadata and membership. Other current
      // members can only append people; they cannot edit group settings,
      // remove existing people, or change ownership.
      allow update: if accountCanWrite() && ((
          isGroupOwner() &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.auth.uid in request.resource.data.memberUids &&
          request.resource.data.memberUids is list
        ) || (
          isMember() &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'memberUids']) &&
          request.resource.data.members is list &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.memberUids is list &&
          request.resource.data.memberUids.hasAll(resource.data.memberUids)
        ) || canRepairOwnPersonalGroup());

      allow delete: if accountCanWrite() && isGroupOwner();

      // Group chat is readable only by current members.
      match /messages/{messageId} {
        function chatGroupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }
        function chatGroupMember() {
          return request.auth != null &&
            request.auth.uid in chatGroupData().memberUids;
        }
        function isGroupOwner() {
          return request.auth != null &&
            request.auth.uid == chatGroupData().ownerId;
        }
        function validImagePath(path) {
          return path is string &&
            path.size() <= 300 &&
            path.matches('groups/' + groupId + '/chat/' + request.auth.uid + '/[^/]+\\.jpg');
        }

        allow read: if chatGroupMember();
        allow create: if accountCanWrite() && chatGroupMember() &&
          request.resource.data.keys().hasOnly([
            'senderUid', 'senderName', 'text', 'createdAt', 'imagePath'
          ]) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.senderName is string &&
          request.resource.data.senderName.size() > 0 &&
          request.resource.data.senderName.size() <= 80 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 1000 &&
          (request.resource.data.text.size() > 0 ||
            ('imagePath' in request.resource.data &&
             validImagePath(request.resource.data.imagePath))) &&
          (!('imagePath' in request.resource.data) ||
            validImagePath(request.resource.data.imagePath)) &&
          request.resource.data.createdAt == request.time;

        // Authors can edit text only; sender, timestamp and image are immutable.
        // A text message may be edited once. The isEdited flag is permanent,
        // and a second update is rejected even if the client bypasses the UI.
        allow update: if accountCanWrite() && chatGroupMember() &&
          request.auth.uid == resource.data.senderUid &&
          !resource.data.keys().hasAny(['imagePath', 'imageUrl']) &&
          (!('isEdited' in resource.data) || resource.data.isEdited == false) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'isEdited']) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000 &&
          request.resource.data.text != resource.data.text &&
          request.resource.data.isEdited == true;

        allow delete: if accountCanWrite() && chatGroupMember() &&
          (request.auth.uid == resource.data.senderUid || isGroupOwner());
      }

      match /expenses/{expenseId} {
        function groupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function isGroupMember() {
          return request.auth != null &&
            request.auth.uid in groupData().memberUids;
        }

        function validExpense() {
          return request.resource.data.amount is number &&
            request.resource.data.amount > 0 &&
            request.resource.data.amount <= 100000000 &&
            request.resource.data.desc is string &&
            request.resource.data.desc.size() > 0 &&
            request.resource.data.desc.size() <= 200 &&
            request.resource.data.payerId is int &&
            request.resource.data.splitMap is map &&
            request.resource.data.splitMap.keys().size() > 0 &&
            request.resource.data.settledBy is list &&
            request.resource.data.settledAmounts is map &&
            request.resource.data.isSettlement == false &&
            request.resource.data.addedBy == request.auth.uid;
        }

        // Any group member may read expenses. Expense writes go through the
        // trusted saveExpense callable below rather than direct client writes.
        allow read: if isGroupMember();
        // Expense creation and financial edits go through the trusted
        // saveExpense callable, which validates dynamic participant IDs and
        // exact split totals before using the Admin SDK to write.
        allow create: if false;

        // Existing expense identity and authorship cannot be reassigned.
        // Only the original expense logger can edit expense details. Group
        // ownership does not grant edit permission on another member's expense.
        allow update: if false && accountCanWrite() && isGroupMember() && (
          (
            request.auth.uid == resource.data.addedBy &&
            request.resource.data.addedBy == resource.data.addedBy &&
            request.resource.data.payerId == resource.data.payerId &&
            request.resource.data.isSettlement == resource.data.isSettlement &&
            request.resource.data.createdAt == resource.data.createdAt &&
            (request.auth.uid == resource.data.addedBy ||
              request.resource.data.settledBy == resource.data.settledBy) &&
            // Only the trusted callable may change pair-settlement allocations.
            // Expense authors must not be able to erase or forge recorded settlements.
            request.resource.data.get('settledAmounts', {}) == resource.data.get('settledAmounts', {}) &&
            // Once any pair settlement has been allocated, changing the share
            // amounts would invalidate that trusted reconciliation.
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['splitMap', 'amount']) ||
              resource.data.get('settledAmounts', {}).size() == 0) &&
            request.resource.data.amount is number &&
            request.resource.data.amount > 0 &&
            request.resource.data.amount <= 100000000 &&
            request.resource.data.desc is string &&
            request.resource.data.desc.size() > 0 &&
            request.resource.data.desc.size() <= 200 &&
            request.resource.data.splitMap is map &&
            request.resource.data.splitMap.keys().size() > 0 &&
            request.resource.data.settledBy is list
          ) ||
          // Only the original expense logger can toggle whole-share status.
          // Pairwise partial settlements are written by the trusted callable.
          (
            isGroupMember() &&
            request.auth.uid == resource.data.addedBy &&
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['settledBy']) &&
            request.resource.data.settledBy is list
          )
        );

        // Only the original expense logger may delete an expense, and only
        // after all pair-settlement allocations against it have been undone.
        allow delete: if accountCanWrite() && isGroupMember() &&
          request.auth.uid == resource.data.addedBy &&
          resource.data.get('settledAmounts', {}).size() == 0;
      }

      // Settlement audit entries are written only by trusted Admin SDK callables.
      match /settlements/{settlementId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        allow write: if false;
      }
    }
  }
}
