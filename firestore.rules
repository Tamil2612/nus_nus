rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public profile directory. Push tokens live in users/{uid}/private/push.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;

      match /private/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /groups/{groupId} {
      function signedIn() {
        return request.auth != null;
      }

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberUids;
      }

      function isGroupOwner() {
        return signedIn() && request.auth.uid == resource.data.ownerId;
      }

      allow read: if isMember();

      // The creator must remain a member so they cannot lock themselves out.
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.ownerId &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.memberUids is list;

      // Only the owner can change group metadata or membership. Ownership is immutable.
      allow update: if isGroupOwner() &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.memberUids is list;

      allow delete: if isGroupOwner();

      match /expenses/{expenseId} {
        function groupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function isGroupMember() {
          return request.auth != null &&
            request.auth.uid in groupData().memberUids;
        }

        function isOwner() {
          return request.auth != null &&
            request.auth.uid == groupData().ownerId;
        }

        function validExpense() {
          return request.resource.data.amount is number &&
            request.resource.data.amount > 0 &&
            request.resource.data.amount <= 100000000 &&
            request.resource.data.desc is string &&
            request.resource.data.desc.size() > 0 &&
            request.resource.data.desc.size() <= 200 &&
            request.resource.data.payerId is int &&
            request.resource.data.splitMap is map &&
            request.resource.data.splitMap.keys().size() > 0 &&
            request.resource.data.settledBy is list &&
            request.resource.data.isSettlement == false &&
            request.resource.data.addedBy == request.auth.uid;
        }

        // Any group member may read expenses and add their own logged expense.
        allow read: if isGroupMember();
        allow create: if isGroupMember() && validExpense();

        // Existing expense identity and authorship cannot be reassigned.
        // The author or owner can edit expense details, but not payer,
        // author, creation time, or legacy-settlement identity.
        allow update: if isGroupMember() && (
          (
            (isOwner() || request.auth.uid == resource.data.addedBy) &&
            request.resource.data.addedBy == resource.data.addedBy &&
            request.resource.data.payerId == resource.data.payerId &&
            request.resource.data.isSettlement == resource.data.isSettlement &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.amount is number &&
            request.resource.data.amount > 0 &&
            request.resource.data.amount <= 100000000 &&
            request.resource.data.desc is string &&
            request.resource.data.desc.size() > 0 &&
            request.resource.data.desc.size() <= 200 &&
            request.resource.data.splitMap is map &&
            request.resource.data.splitMap.keys().size() > 0 &&
            request.resource.data.settledBy is list
          ) ||
          // Settlement flags are status tracking, not payment processing.
          // Any group member may update settledBy status.
          (
            isGroupMember() &&
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['settledBy']) &&
            request.resource.data.settledBy is list
          )
        );

        // The expense author or group owner may delete an expense.
        allow delete: if isGroupMember() &&
          (isOwner() || request.auth.uid == resource.data.addedBy);
      }
    }
  }
}