rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    // Storage rules allow only two Firestore lookups per request, so this uses
    // a single get() on the user document (the group lookup is the second).
    // Every signed-in user has a profile document; if it were missing the get
    // fails and the write is denied, which is the safe outcome.
    function accountCanWrite() {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data
          .get('accountDeletionInProgress', false) != true;
    }
    function groupData(groupId) {
      return firestore.get(/databases/(default)/documents/groups/$(groupId)).data;
    }
    function isGroupMember(groupId) {
      return signedIn() &&
        request.auth.uid in groupData(groupId).memberUids;
    }
    function isGroupOwner(groupId) {
      return signedIn() &&
        request.auth.uid == groupData(groupId).ownerId;
    }

    match /groups/{groupId}/chat/{uid}/{fileName} {
      allow read: if isGroupMember(groupId);
      allow create: if accountCanWrite() && isGroupMember(groupId) &&
        request.auth.uid == uid &&
        request.resource.size > 0 &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg';
      allow update: if false;
      allow delete: if accountCanWrite() && isGroupMember(groupId) &&
        (request.auth.uid == uid || isGroupOwner(groupId));
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}